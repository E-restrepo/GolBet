@model GolBet.Services.DTOs.MatchFormDto

@{
    ViewData["Title"] = "Nuevo partido";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">⚽ Nuevo partido</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <partial name="_MatchForm" model="Model" />
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
