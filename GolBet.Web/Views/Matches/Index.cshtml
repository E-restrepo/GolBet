@* GolBet.Web/Views/Matches/Index.cshtml *@ 
@using GolBet.Entities.Enums
@using GolBet.Web.Helpers
@model IEnumerable<GolBet.Services.DTOs.MatchDto>

@{
    ViewData["Title"] = "Partidos";
}

@{
    var current = (MatchStatus?)ViewBag.CurrentStatus;
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="row g-3 align-items-center mb-4">
    <div class="col-12 col-lg-7 d-flex gap-2 flex-wrap">
        <a asp-action="Index" asp-route-searchTerm="@searchTerm"
           class="btn btn-sm @(current is null ? "btn-success" : "btn-outline-success")">
            Todos
        </a>
        <a asp-action="Index" asp-route-status="@MatchStatus.Scheduled" asp-route-searchTerm="@searchTerm"
           class="btn btn-sm @(current == MatchStatus.Scheduled ? "btn-success" : "btn-outline-success")">
            Programados
        </a>
        <a asp-action="Index" asp-route-status="@MatchStatus.InProgress" asp-route-searchTerm="@searchTerm"
           class="btn btn-sm @(current == MatchStatus.InProgress ? "btn-success" : "btn-outline-success")">
            En juego
        </a>
        <a asp-action="Index" asp-route-status="@MatchStatus.Finished" asp-route-searchTerm="@searchTerm"
           class="btn btn-sm @(current == MatchStatus.Finished ? "btn-success" : "btn-outline-success")">
            Finalizados
        </a>
    </div>

    <!-- Buscador de Partidos -->
    <div class="col-12 col-lg-5">
        <form asp-action="Index" method="get">
            @if (current.HasValue)
            {
                <input type="hidden" name="status" value="@current.Value" />
            }
            <div class="input-group input-group-sm shadow-sm">
                <input type="text" name="searchTerm" value="@searchTerm" class="form-control"
                       placeholder="Buscar por equipo o ciudad..." aria-label="Buscar partidos" />
                <button type="submit" class="btn btn-primary">
                    🔍 Buscar
                </button>
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <a asp-action="Index" asp-route-status="@current" class="btn btn-outline-secondary" title="Limpiar búsqueda">
                        ✕ Limpiar
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">⚽ Cartelera de partidos</h2>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success">
            + Nuevo partido
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info d-flex align-items-center justify-content-between p-4 my-4 rounded shadow-sm" role="alert">
        <div>
            <h5 class="alert-heading mb-1">🔍 No se encontraron partidos</h5>
            <p class="mb-0">
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <span>No hay coincidencias para el término <strong>"@searchTerm"</strong>@(current.HasValue ? $" con estado '{current}'" : "").</span>
                }
                else
                {
                    <span>No hay partidos registrados para el filtro seleccionado.</span>
                }
            </p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-sm btn-outline-primary">Ver todos los partidos</a>
        </div>
    </div>
}
else
{
<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    @foreach (var match in Model)
    {
        <div class="col">

            <div class="card h-100 shadow-sm">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <small class="text-muted">

                        📅 @match.Date.ToColombiaTime().ToString("ddd dd MMM · h:mm tt")

                    </small>

                    @switch (match.Status)
                    {
                        case MatchStatus.Scheduled:
                            <span class="badge bg-primary">Programado</span>
                            break;

                        case MatchStatus.InProgress:
                            <span class="badge bg-warning text-dark">En juego</span>
                            break;

                        case MatchStatus.Finished:
                            <span class="badge bg-secondary">Finalizado</span>
                            break;
                    }

                </div>

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center text-center">

                        <div class="w-100">

                            <img src="@(match.HomeTeamCrestUrl ?? "https://placehold.co/60x60/e9ecef/6c757d?text=FC")"
                                 alt="@match.HomeTeamName" width="60" height="60" class="mb-1" />

                            <div class="fw-bold small">@match.HomeTeamName</div>

                        </div>

                        <div class="px-3 text-nowrap">

                            @if (match.Status == MatchStatus.Finished)
                            {
                                <span class="fs-3 fw-bold">@match.HomeGoals - @match.AwayGoals</span>
                            }
                            else
                            {
                                <span class="fs-4 text-muted">vs</span>
                            }

                        </div>

                        <div class="w-100">

                            <img src="@(match.AwayTeamCrestUrl ?? "https://placehold.co/60x60?text=⚽")"
                                 alt="@match.AwayTeamName" width="60" height="60" class="mb-1" />

                            <div class="fw-bold small">@match.AwayTeamName</div>

                        </div>

                    </div>

                </div>

                <div class="card-footer">

                    <div class="row g-2 text-center">

                        <div class="col">

                            <div class="border rounded py-1">

                                <small class="text-muted d-block">1 · Local</small>

                                <span class="fw-bold">@match.HomeOdds.ToString("0.00")</span>

                            </div>

                        </div>

                        <div class="col">

                            <div class="border rounded py-1">

                                <small class="text-muted d-block">X · Empate</small>

                                <span class="fw-bold">@match.DrawOdds.ToString("0.00")</span>

                            </div>

                        </div>

                        <div class="col">

                            <div class="border rounded py-1">

                                <small class="text-muted d-block">2 · Visitante</small>

                                <span class="fw-bold">@match.AwayOdds.ToString("0.00")</span>

                            </div>

                        </div>

                    </div>

                    <a asp-action="Detail" asp-route-id="@match.Id"
                       class="btn btn-sm btn-outline-secondary w-100 mt-2">
                        Ver detalle
                    </a>

                </div>

            </div>

        </div>

    }

</div>
}
