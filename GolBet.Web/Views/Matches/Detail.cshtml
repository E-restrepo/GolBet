@* GolBet.Web/Views/Matches/Detail.cshtml *@
@using GolBet.Entities.Enums
@using GolBet.Web.Helpers
@model GolBet.Services.DTOs.MatchDetailDto

@{
    ViewData["Title"] = $"{Model.HomeTeamName} vs {Model.AwayTeamName}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Partidos</a></li>
        <li class="breadcrumb-item active">@Model.HomeTeamName vs @Model.AwayTeamName</li>
    </ol>
</nav>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>📅 @Model.Date.ToColombiaTime().ToString("dddd dd MMM yyyy · h:mm tt")</span>
        @switch (Model.Status)
        {
            case MatchStatus.Scheduled:
                <span class="badge bg-primary">Programado</span>
                break;
            case MatchStatus.InProgress:
                <span class="badge bg-warning text-dark">En juego</span>
                break;
            case MatchStatus.Finished:
                <span class="badge bg-secondary">Finalizado</span>
                break;
        }
    </div>

    <div class="card-body">
        <div class="d-flex justify-content-around align-items-center text-center py-3">
            <div>
                <img src="@(Model.HomeTeamCrestUrl ?? "https://placehold.co/100x100/e9ecef/6c757d?text=FC")"
                     alt="@Model.HomeTeamName" width="100" height="100" class="mb-2" />
                <h4>@Model.HomeTeamName</h4>
            </div>

            <div class="px-4 text-nowrap">
                @if (Model.Status == MatchStatus.Finished)
                {
                    <span class="display-4 fw-bold">@Model.HomeGoals - @Model.AwayGoals</span>
                }
                else
                {
                    <span class="display-6 text-muted">VS</span>
                }
            </div>

            <div>
                <img src="@(Model.AwayTeamCrestUrl ?? "https://placehold.co/100x100/e9ecef/6c757d?text=FC")"
                     alt="@Model.AwayTeamName" width="100" height="100" class="mb-2" />
                <h4>@Model.AwayTeamName</h4>
            </div>
        </div>

        <hr />

        @if (Model.Status == MatchStatus.Scheduled)
        {
            @if (User.IsInRole("Bettor") || User.IsInRole("Better"))
            {
                <div class="p-3 bg-light rounded border">
                    <h5 class="text-center mb-3">🎯 Haz tu apuesta</h5>
                    <form asp-controller="Bets" asp-action="Place" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MatchId" value="@Model.Id" />

                        <div class="row justify-content-center mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Monto en FootCoins</label>
                                <div class="input-group">
                                    <span class="input-group-text">🪙</span>
                                    <input type="number" name="Amount" class="form-control"
                                           min="1" max="9999999" step="1" value="100" required />
                                    <span class="input-group-text">FootCoins</span>
                                </div>
                                <div class="form-text text-muted">Elige tu monto y haz clic en la cuota para apostar.</div>
                            </div>
                        </div>

                        <div class="row justify-content-center g-3">
                            <div class="col-md-3">
                                <button type="submit" name="Pick" value="Home" class="btn btn-outline-success w-100 py-3">
                                    <div class="text-muted small">1 · @Model.HomeTeamName</div>
                                    <div class="fs-3 fw-bold">@Model.HomeOdds.ToString("0.00")</div>
                                </button>
                            </div>
                            <div class="col-md-3">
                                <button type="submit" name="Pick" value="Draw" class="btn btn-outline-success w-100 py-3">
                                    <div class="text-muted small">X · Empate</div>
                                    <div class="fs-3 fw-bold">@Model.DrawOdds.ToString("0.00")</div>
                                </button>
                            </div>
                            <div class="col-md-3">
                                <button type="submit" name="Pick" value="Away" class="btn btn-outline-success w-100 py-3">
                                    <div class="text-muted small">2 · @Model.AwayTeamName</div>
                                    <div class="fs-3 fw-bold">@Model.AwayOdds.ToString("0.00")</div>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            }
            else if (!User.Identity?.IsAuthenticated ?? true)
            {
                <h5 class="text-center mb-3">Cuotas</h5>
                <div class="row justify-content-center g-3 mb-3">
                    <div class="col-md-3">
                        <div class="border rounded text-center py-3">
                            <div class="text-muted">1 · @Model.HomeTeamName</div>
                            <div class="fs-3 fw-bold">@Model.HomeOdds.ToString("0.00")</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded text-center py-3">
                            <div class="text-muted">X · Empate</div>
                            <div class="fs-3 fw-bold">@Model.DrawOdds.ToString("0.00")</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded text-center py-3">
                            <div class="text-muted">2 · @Model.AwayTeamName</div>
                            <div class="fs-3 fw-bold">@Model.AwayOdds.ToString("0.00")</div>
                        </div>
                    </div>
                </div>
                <div class="alert alert-info d-flex justify-content-between align-items-center">
                    <span>Inicia sesión como apostador para realizar apuestas en este partido.</span>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">Iniciar sesión para apostar</a>
                </div>
            }
            else
            {
                <h5 class="text-center mb-3">Cuotas</h5>
                <div class="row justify-content-center g-3">
                    <div class="col-md-3">
                        <div class="border rounded text-center py-3">
                            <div class="text-muted">1 · @Model.HomeTeamName</div>
                            <div class="fs-3 fw-bold">@Model.HomeOdds.ToString("0.00")</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded text-center py-3">
                            <div class="text-muted">X · Empate</div>
                            <div class="fs-3 fw-bold">@Model.DrawOdds.ToString("0.00")</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded text-center py-3">
                            <div class="text-muted">2 · @Model.AwayTeamName</div>
                            <div class="fs-3 fw-bold">@Model.AwayOdds.ToString("0.00")</div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <h5 class="text-center mb-3">Cuotas</h5>
            <div class="row justify-content-center g-3">
                <div class="col-md-3">
                    <div class="border rounded text-center py-3">
                        <div class="text-muted">1 · @Model.HomeTeamName</div>
                        <div class="fs-3 fw-bold">@Model.HomeOdds.ToString("0.00")</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded text-center py-3">
                        <div class="text-muted">X · Empate</div>
                        <div class="fs-3 fw-bold">@Model.DrawOdds.ToString("0.00")</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded text-center py-3">
                        <div class="text-muted">2 · @Model.AwayTeamName</div>
                        <div class="fs-3 fw-bold">@Model.AwayOdds.ToString("0.00")</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card-footer d-flex justify-content-between align-items-center">
        <small class="text-muted">🎟️ @Model.TotalBets apuestas realizadas</small>

        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                    Editar partido
                </a>
            }
        </div>
    </div>
</div>
