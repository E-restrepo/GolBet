@* GolBet.Web/Views/Bets/MyBets.cshtml *@
@using GolBet.Entities.Enums
@using GolBet.Web.Helpers
@model IEnumerable<GolBet.Services.DTOs.BetDto>

@{
    ViewData["Title"] = "Mis apuestas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🎟️ Mis apuestas</h2>
    <a asp-controller="Matches" asp-action="Index" class="btn btn-outline-success">
        ⚽ Ver cartelera
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info py-4 text-center shadow-sm">
        <h4 class="alert-heading">Aún no has hecho ninguna apuesta</h4>
        <p class="mb-3">Explora la cartelera de partidos programados y pon a prueba tu instinto futbolero.</p>
        <a asp-controller="Matches" asp-action="Index" class="btn btn-success">
            Ver cartelera de partidos
        </a>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Partido</th>
                            <th>Fecha</th>
                            <th>Selección</th>
                            <th class="text-end">Monto</th>
                            <th class="text-center">Cuota</th>
                            <th class="text-end">Ganancia potencial</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bet in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @bet.MatchHomeTeamName vs @bet.MatchAwayTeamName
                                </td>
                                <td>
                                    @bet.MatchDate.ToColombiaTime().ToString("dd/MM/yyyy h:mm tt")
                                </td>
                                <td>
                                    @switch (bet.Pick)
                                    {
                                        case BetPick.Home:
                                            <span class="badge bg-primary text-wrap">1 · @bet.MatchHomeTeamName</span>
                                            break;
                                        case BetPick.Draw:
                                            <span class="badge bg-secondary text-wrap">X · Empate</span>
                                            break;
                                        case BetPick.Away:
                                            <span class="badge bg-info text-dark text-wrap">2 · @bet.MatchAwayTeamName</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end fw-bold">
                                    🪙 @bet.Amount.ToString("N0")
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        @bet.OddsAtPlacement.ToString("0.00")
                                    </span>
                                </td>
                                <td class="text-end text-success fw-bold">
                                    🪙 @bet.PotentialPayout.ToString("N0")
                                </td>
                                <td class="text-center">
                                    @switch (bet.Status)
                                    {
                                        case BetStatus.Pending:
                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                            break;
                                        case BetStatus.Won:
                                            <span class="badge bg-success">Ganada</span>
                                            break;
                                        case BetStatus.Lost:
                                            <span class="badge bg-secondary">Perdida</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
