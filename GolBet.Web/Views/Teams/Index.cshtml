@model IEnumerable<GolBet.Services.DTOs.TeamDto>

@{
    ViewData["Title"] = "Equipos";
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h2 class="mb-0">🛡️ Equipos</h2>

    <div class="d-flex gap-2 align-items-center">
        <!-- Buscador de Equipos -->
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <div class="input-group input-group-sm shadow-sm" style="min-width: 260px;">
                <input type="text" name="searchTerm" value="@searchTerm" class="form-control"
                       placeholder="Buscar por nombre o ciudad..." aria-label="Buscar equipos" />
                <button type="submit" class="btn btn-primary">
                    🔍 Buscar
                </button>
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar búsqueda">
                        ✕ Limpiar
                    </a>
                }
            </div>
        </form>

        <a asp-action="Create" class="btn btn-success text-nowrap">
            + Nuevo equipo
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info d-flex align-items-center justify-content-between p-4 my-4 rounded shadow-sm" role="alert">
        <div>
            <h5 class="alert-heading mb-1">🔍 No se encontraron equipos</h5>
            <p class="mb-0">
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <span>No hay equipos que coincidan con la búsqueda <strong>"@searchTerm"</strong>.</span>
                }
                else
                {
                    <span>Actualmente no hay equipos activos registrados en el sistema.</span>
                }
            </p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-sm btn-outline-primary">Ver todos los equipos</a>
        </div>
    </div>
}
else
{

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">Escudo</th>
                    <th>Nombre</th>
                    <th>Ciudad</th>
                    <th class="text-end" style="width: 200px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var team in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(team.CrestUrl))
                            {
                                <img src="@team.CrestUrl" alt="@team.Name" style="width: 40px; height: 40px; object-fit: contain;" />
                            }
                            else
                            {
                                <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center"
                                     style="width: 40px; height: 40px; font-size: 0.8rem; font-weight: bold;">
                                    FC
                                </div>
                            }
                        </td>
                        <td class="fw-bold">@team.Name</td>
                        <td>@team.City</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@team.Id" class="btn btn-sm btn-outline-primary me-1">
                                Editar
                            </a>
                            <form asp-action="Deactivate" asp-route-id="@team.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Está seguro de que desea desactivar este equipo?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Desactivar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
}
